<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/surface">

    <!-- 标题栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/song_info"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btn_close"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cancel" />

    </LinearLayout>

    <!-- 内容区域 -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="400dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 基本信息 -->
            <include
                android:id="@+id/item_title"
                layout="@layout/item_song_info_row" />

            <include
                android:id="@+id/item_artist"
                layout="@layout/item_song_info_row" />

            <include
                android:id="@+id/item_album"
                layout="@layout/item_song_info_row" />

            <!-- 分割线 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:background="@color/divider" />

            <!-- 文件信息 -->
            <include
                android:id="@+id/item_path"
                layout="@layout/item_song_info_row" />

            <include
                android:id="@+id/item_size"
                layout="@layout/item_song_info_row" />

            <include
                android:id="@+id/item_format"
                layout="@layout/item_song_info_row" />

            <include
                android:id="@+id/item_duration"
                layout="@layout/item_song_info_row" />

            <!-- 分割线 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:background="@color/divider" />

            <!-- 时间信息 -->
            <include
                android:id="@+id/item_date_added"
                layout="@layout/item_song_info_row" />

            <include
                android:id="@+id/item_date_modified"
                layout="@layout/item_song_info_row" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- 底部按钮 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_copy_path"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="@string/copy_path"
        android:textColor="@color/white"
        android:backgroundTint="@color/purple_500" />

</LinearLayout>
